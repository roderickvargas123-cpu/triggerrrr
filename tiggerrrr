-- ==========================================
-- CONTROLES CON DETECCIÓN DE DOBLE TOQUE
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Insert then
        screenGui.Enabled = not screenGui.Enabled
    end

    if not gameProcessed and input.KeyCode == Enum.KeyCode.P then
        local tiempoActual = tick()
        
        -- Lógica de Doble Pulsación (Si presionaste P hace menos de 0.35 segundos)
        if tiempoActual - lastPPressTime < 0.35 then
            camlockActivo = true
            textLabel.Text = "[ CAMLOCK ACTIVADO ]"
        else
            camlockActivo = false
            textLabel.Text = "[ TRIGGER NORMAL ]"
        end
        
        lastPPressTime = tiempoActual
        holdingTriggerButton = true
        frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.P then
        holdingTriggerButton = false
        frame.BorderColor3 = Color3.fromRGB(255, 0, 0)
        textLabel.Text = "[ XENO HYBRID: Hold 'P' ]"
    end
end)

-- ==========================================
-- SISTEMA DE DISPARO (LA MACRO)
-- ==========================================
local function DispararComboRapido()
    if firingCombo then return end
    firingCombo = true

    local secuencia = {Enum.KeyCode.Five, Enum.KeyCode.Four, Enum.KeyCode.Three}

    for _, tecla in ipairs(secuencia) do
        VirtualInputManager:SendKeyEvent(true, tecla, false, game)
        VirtualInputManager:SendKeyEvent(false, tecla, false, game)
        task.wait() 
        if mouse1click then
            mouse1click()
        else
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
        task.wait()
    end

    task.wait(0.8)
    firingCombo = false
end

-- ==========================================
-- FUNCIONES AUXILIARES Y VALIDACIÓN
-- ==========================================
local function EsObjetivoValido(personaje)
    if not personaje or not personaje:FindFirstChild("Humanoid") then return false end
    if personaje.Humanoid.Health <= 0 then return false end
    
    local bodyEffects = personaje:FindFirstChild("BodyEffects")
    if bodyEffects and bodyEffects:FindFirstChild("K.O") and bodyEffects["K.O"].Value == true then
        return false
    end
    
    return true
end

local function EsApuntadoOPrimeraPersona()
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        return true
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        local distancia = (Camera.CFrame.Position - LocalPlayer.Character.Head.Position).Magnitude
        if distancia < 1.5 then 
            return true 
        end
    end
    return false
end

local function ObtenerObjetivoEnFOV()
    local enemigoMasCercano = nil
    local distanciaMinima = Config.FovRadio
    local centroPantalla = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, jugador in ipairs(Players:GetPlayers()) do
        if jugador ~= LocalPlayer and jugador.Character and jugador.Character:FindFirstChild("UpperTorso") then
            if EsObjetivoValido(jugador.Character) then
                local parte = jugador.Character["UpperTorso"]
                local posicionPantalla, enPantalla = Camera:WorldToViewportPoint(parte.Position)
                
                if enPantalla then
                    local distanciaAlCentro = (Vector2.new(posicionPantalla.X, posicionPantalla.Y) - centroPantalla).Magnitude
                    if distanciaAlCentro < distanciaMinima then
                        distanciaMinima = distanciaAlCentro
                        enemigoMasCercano = jugador.Character
                    end
                end
            end
        end
    end
    return enemigoMasCercano
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include 
rayParams.IgnoreWater = true

task.spawn(function()
    while task.wait(0.5) do
        local tempLista = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                table.insert(tempLista, player.Character)
            end
        end
        rayParams.FilterDescendantsInstances = tempLista
    end
end)

-- ==========================================
-- MOTOR HÍBRIDO PRINCIPAL
-- ==========================================
RunService.RenderStepped:Connect(function()
    if holdingTriggerButton and getgenv().XenoTriggerBot and LocalPlayer.Character then
        
        local modoApuntado = EsApuntadoOPrimeraPersona()

        -- El Camlock solo se activa SI estás apuntando Y SI presionaste P dos veces
        if modoApuntado and camlockActivo then
            -- =========================================================
            -- MODO 1: CAMLOCK SMOOTH + TRIGGERBOT (Doble Toque)
            -- =========================================================
            if objetivoActual and not EsObjetivoValido(objetivoActual) then
                objetivoActual = nil
                ultimoObjetivo = nil
                posicionMemoria = nil
            end

            if not objetivoActual then
                objetivoActual = ObtenerObjetivoEnFOV()
                if objetivoActual then
                    tiempoInicioLock = tick()
                    posicionMemoria = objetivoActual.PrimaryPart.Position
                end
            end
            
            if objetivoActual then
                if tick() - tiempoUltimoCambioParte > (math.random(8, 15) / 10) then
                    parteActual = Config.PartesDinamicas[math.random(1, #Config.PartesDinamicas)]
                    tiempoUltimoCambioParte = tick()
                    offsetAleatorioTorso = Vector3.new((math.random()-0.5)*0.5, (math.random()-0.5)*0.5, (math.random()-0.5)*0.5)
                end
                
                local parteObjetivoFisica = objetivoActual:FindFirstChild(parteActual) or objetivoActual:FindFirstChild("UpperTorso")
                
                local velocidadReal = parteObjetivoFisica.AssemblyLinearVelocity
                local cambioDeVelocidad = (velocidadReal - ultimaVelocidad).Magnitude
                
                if cambioDeVelocidad > Config.SensibilidadReaccion and tick() > retrasoMentalHasta + 0.5 then
                    retrasoMentalHasta = tick() + Config.TiempoReaccionSalto
                end
                ultimaVelocidad = velocidadReal
                
                local tiempo = tick() * 4
                local posicionFuturaIdeal = parteObjetivoFisica.Position 
                    + offsetAleatorioTorso 
                    + (velocidadReal * Config.PrediccionOffset) 
                    + Vector3.new(math.noise(tiempo,0,0)*Config.TemblorHumano, math.noise(0,tiempo,0)*Config.TemblorHumano, math.noise(0,0,tiempo)*Config.TemblorHumano)
                    
                if not posicionMemoria then posicionMemoria = posicionFuturaIdeal end
                
                if tick() < retrasoMentalHasta then
                    posicionMemoria = posicionMemoria:Lerp(posicionFuturaIdeal, 0.02)
                else
                    posicionMemoria = posicionMemoria:Lerp(posicionFuturaIdeal, Config.FlickVelocidad)
                end

                local tiempoTranscurrido = tick() - tiempoInicioLock
                local progreso = math.clamp(tiempoTranscurrido / Config.TiempoEnganche, 0.05, 1)
                local suavizadoFinal = Config.Suavizado * (progreso * progreso * (3 - 2 * progreso))
                
                local centroPantalla = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local pos2D, enPantalla = Camera:WorldToViewportPoint(parteObjetivoFisica.Position)
                if enPantalla and (Vector2.new(pos2D.X, pos2D.Y) - centroPantalla).Magnitude < Config.ZonaMuerta then
                    suavizadoFinal = suavizadoFinal * 0.5
                end
                
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, posicionMemoria), suavizadoFinal)
                
                local unitRay = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rayParams)
                
                if rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(objetivoActual) then
                    DispararComboRapido()
                end
            end

        else
            -- =========================================================
            -- MODO 2: SOLO TRIGGERBOT (Un solo Toque o Tercera Persona)
            -- =========================================================
            objetivoActual = nil
            posicionMemoria = nil
            ultimoObjetivo = nil
            
            local mousePos = UserInputService:GetMouseLocation()
            local unitRay = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
            local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rayParams)
            
            if rayResult and rayResult.Instance then
                local model = rayResult.Instance:FindFirstAncestorOfClass("Model")
                
                if model and EsObjetivoValido(model) then
                    local targetPlayer = Players:GetPlayerFromCharacter(model)
                    if targetPlayer and targetPlayer ~= LocalPlayer then
                        DispararComboRapido()
                    end
                end
            end
            
        end
    else
        objetivoActual = nil
        posicionMemoria = nil
    end
end)
