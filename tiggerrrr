-- ==========================================
-- CONTROLES
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Insert then
        screenGui.Enabled = not screenGui.Enabled
    end

    if not gameProcessed and input.KeyCode == Enum.KeyCode.P then
        holdingTriggerButton = true
        frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.P then
        holdingTriggerButton = false
        frame.BorderColor3 = Color3.fromRGB(255, 0, 0)
    end
end)

-- ==========================================
-- SISTEMA DE DISPARO
-- ==========================================
local function DispararComboRapido()
    if firingCombo then return end
    firingCombo = true

    local secuencia = {Enum.KeyCode.Five, Enum.KeyCode.Four, Enum.KeyCode.Three}

    for _, tecla in ipairs(secuencia) do
        VirtualInputManager:SendKeyEvent(true, tecla, false, game)
        VirtualInputManager:SendKeyEvent(false, tecla, false, game)
        
        task.wait() 
        
        if mouse1click then
            mouse1click()
        else
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
        
        task.wait()
    end

    task.wait(0.5)
    firingCombo = false
end

-- ==========================================
-- OPTIMIZACIÓN DEL WALLBANG (Cero Lag Absoluto)
-- ==========================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include -- Atraviesa paredes
rayParams.IgnoreWater = true

-- ¡AQUÍ ESTÁ LA MAGIA! Actualizamos la lista Y el láser en segundo plano
task.spawn(function()
    while task.wait(0.5) do
        local tempLista = {}
        for _, player in ipairs(Players:GetPlayers()) do
            -- Filtramos para que solo meta a los enemigos (excluye tu propio cuerpo automáticamente)
            if player ~= LocalPlayer and player.Character then
                table.insert(tempLista, player.Character)
            end
        end
        -- Asignamos la lista al rayo SOLO 2 veces por segundo, no 60 veces.
        rayParams.FilterDescendantsInstances = tempLista
    end
end)

-- ==========================================
-- MOTOR PRINCIPAL
-- ==========================================
RunService.RenderStepped:Connect(function()
    -- El motor ahora está libre de carga. Solo lanza el láser y listo.
    if holdingTriggerButton and getgenv().XenoTriggerBot and LocalPlayer.Character then
        
        local mousePos = UserInputService:GetMouseLocation()
        
        -- Corrección de píxeles para que la mira sea 100% precisa
        local guiInset, _ = GuiService:GetGuiInset()
        local unitRay = Camera:ViewportPointToRay(mousePos.X, mousePos.Y - guiInset.Y)
        
        local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rayParams)
        
        if rayResult and rayResult.Instance then
            local model = rayResult.Instance:FindFirstAncestorOfClass("Model")
            
            if model and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
                local targetPlayer = Players:GetPlayerFromCharacter(model)
                
                if targetPlayer and targetPlayer ~= LocalPlayer then
                    
                    -- ==========================================
                    -- EL KNOCK CHECK
                    -- ==========================================
                    local estaNoqueado = false
                    local bodyEffects = model:FindFirstChild("BodyEffects")
                    
                    if bodyEffects and bodyEffects:FindFirstChild("K.O") then
                        estaNoqueado = bodyEffects["K.O"].Value
                    end
                    
                    if not estaNoqueado then
                        DispararComboRapido()
                    end
                    -- ==========================================
                    
                end
            end
        end
    end
end)
