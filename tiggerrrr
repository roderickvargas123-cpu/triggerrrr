-- ==========================================
-- XENO HUB: HYBRID COMBO TRIGGERBOT + SMOOTH CAMLOCK (Double Tap Update)
-- ==========================================
if getgenv().XenoTriggerBot then return end
getgenv().XenoTriggerBot = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local holdingTriggerButton = false
local firingCombo = false

-- Variables para el Doble Toque (NUEVO)
local lastPPressTime = 0
local camlockActivo = false

-- ==========================================
-- CONFIGURACIÓN DEL CAMLOCK
-- ==========================================
local Config = {
    FovRadio = 30,             
    Suavizado = 0.085,         
    PrediccionOffset = 0.04,  
    TemblorHumano = 0.5,       
    
    TiempoEnganche = 0.25,     
    ZonaMuerta = 5,            
    
    PartesDinamicas = {"UpperTorso", "LowerTorso", "Head", "RightUpperArm", "LeftUpperArm"},
    TiempoReaccionSalto = 0.15, 
    SensibilidadReaccion = 12, 
    FlickVelocidad = 0.25      
}

-- Variables del Camlock
local objetivoActual = nil
local ultimoObjetivo = nil
local tiempoInicioLock = 0
local offsetAleatorioTorso = Vector3.new(0, 0, 0)
local parteActual = "UpperTorso"
local tiempoUltimoCambioParte = 0
local posicionMemoria = nil
local retrasoMentalHasta = 0
local ultimaVelocidad = Vector3.new(0, 0, 0)

-- ==========================================
-- INTERFAZ GRÁFICA
-- ==========================================
